<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="gtk" version="4.0"/>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkFixed" id="wlayout">
    <property name="width-request">1000</property>
    <property name="height-request">800</property>
    <property name="hexpand">1</property>
    <property name="vexpand">1</property>
    <child>
      <object class="GtkBox">
        <property name="width-request">1000</property>
        <property name="height-request">800</property>
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="wmenu">
            <property name="height-request">25</property>
            <property name="baseline-position">top</property>
            <child>
              <placeholder/>
            </child>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkPaned" id="ulayout">
            <property name="focusable">1</property>
            <property name="hexpand">1</property>
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <property name="position">550</property>
            <property name="start-child">
              <object class="GtkPaned" id="user-layout">
                <property name="resize-start-child">0</property>
                <property name="focusable">1</property>
                <property name="wide-handle">1</property>
                <property name="start-child">
                  <object class="GtkBox" id="viewport-container">
                    <property name="width-request">500</property>
                    <property name="height-request">500</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="vname">
                        <property name="label" translatable="1">Viewport</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="wviewport">
                        <property name="width-request">400</property>
                        <property name="height-request">400</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <placeholder/>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="end-child">
                  <object class="GtkBox" id="inspector-container">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="iname">
                        <property name="label" translatable="1">Inspector</property>
                      </object>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="end-child">
              <object class="GtkBox" id="console-layout">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="focusable">1</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
